---
import BaseLayout from "../layouts/BaseLayout.astro";
import RamCard from "../components/RamCard.astro";
import ModuleCard from "../components/ModuleCard.astro";
import SectionRibbon from "../components/SectionRibbon.astro";
import ComparisonMatrix from "../components/ComparisonMatrix.astro";
import AxisLegend from "../components/AxisLegend.astro";
import {
    dramStandards,
    moduleStandards,
    allFamilies,
    allPackagingTypes,
    packagingLabels,
    familyAccentMap,
    type DramFamily,
    type Packaging,
} from "../content/ram-types";

const familyLabels: Record<DramFamily, string> = {
    ddr: "DDR SDRAM",
    lpddr: "LPDDR",
    gddr: "GDDR",
    hbm: "HBM",
};

const packagingOrder = allPackagingTypes;

// Pre-compute compatible families for each module standard (avoids const in template map)
interface ModuleFamilyInfo {
    readonly mod: (typeof moduleStandards)[number];
    readonly families: readonly DramFamily[];
    readonly familyClasses: readonly string[];
}

const moduleFamilyInfo: readonly ModuleFamilyInfo[] = moduleStandards.map(
    (mod) => {
        const compatibleFamilies = new Set<DramFamily>();
        for (const stdId of mod.compatibleStandards) {
            const std = dramStandards.find((s) => s.id === stdId);
            if (std) compatibleFamilies.add(std.family);
        }
        const families = [...compatibleFamilies];
        return {
            mod,
            families,
            familyClasses: families.map((f) => `explore-grid__item--${f}`),
        };
    },
);
---

<BaseLayout title="Explore — RAM Cheatsheet DRAM & Module Explorer">
    <!-- ══════════════════════════════════════════════════════════════════════════ -->
    <!-- EXPLORE HERO -->
    <!-- ══════════════════════════════════════════════════════════════════════════ -->
    <section
        class="explore-hero section-band"
        aria-labelledby="explore-heading"
    >
        <div class="container flow">
            <h1 id="explore-heading" class="explore-hero__title text-balance">
                Explore DRAM Standards & Modules
            </h1>
            <p class="explore-hero__subtitle text-pretty">
                Filter the landscape by DRAM family and packaging type. Cards
                dim when filtered out — the full poster stays visible.
            </p>
            <AxisLegend />
        </div>
    </section>

    <hr class="divider container" />

    <!-- ══════════════════════════════════════════════════════════════════════════ -->
    <!-- FILTER CONTROLS -->
    <!-- ══════════════════════════════════════════════════════════════════════════ -->
    <section class="section-band container" aria-label="Filter controls">
        <div class="filter-section">
            <div class="filter-group">
                <span class="filter-group__label" id="family-filter-label"
                    >DRAM Family</span
                >
                <div
                    class="filter-bar"
                    role="group"
                    aria-labelledby="family-filter-label"
                >
                    <button
                        class="filter-btn filter-btn--all"
                        data-filter="family"
                        data-value="all"
                        aria-pressed="true"
                    >
                        All
                    </button>
                    {
                        allFamilies.map((family) => (
                            <button
                                class:list={[
                                    "filter-btn",
                                    `filter-btn--${family}`,
                                ]}
                                data-filter="family"
                                data-value={family}
                                aria-pressed="false"
                            >
                                {familyLabels[family]}
                            </button>
                        ))
                    }
                </div>
            </div>

            <div class="filter-group">
                <span class="filter-group__label" id="packaging-filter-label"
                    >Packaging</span
                >
                <div
                    class="filter-bar"
                    role="group"
                    aria-labelledby="packaging-filter-label"
                >
                    <button
                        class="filter-btn filter-btn--all"
                        data-filter="packaging"
                        data-value="all"
                        aria-pressed="true"
                    >
                        All
                    </button>
                    {
                        packagingOrder.map((pkg) => (
                            <button
                                class="filter-btn"
                                data-filter="packaging"
                                data-value={pkg}
                                aria-pressed="false"
                            >
                                {packagingLabels[pkg]}
                            </button>
                        ))
                    }
                </div>
            </div>

            <div class="filter-status" aria-live="polite" aria-atomic="true">
                <span class="filter-status__text" id="filter-status-text">
                    Showing {dramStandards.length} DRAM standards and {
                        moduleStandards.length
                    } module types
                </span>
                <button
                    class="filter-reset-btn"
                    id="reset-filters"
                    style="display: none;"
                >
                    <svg
                        viewBox="0 0 16 16"
                        width="12"
                        height="12"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        aria-hidden="true"
                    >
                        <path d="M2 2l12 12M14 2L2 14"></path>
                    </svg>
                    Reset filters
                </button>
            </div>
        </div>
    </section>

    <!-- ══════════════════════════════════════════════════════════════════════════ -->
    <!-- DRAM STANDARDS GRID -->
    <!-- ══════════════════════════════════════════════════════════════════════════ -->
    <section
        class="section-band container flow"
        aria-labelledby="dram-standards-heading"
    >
        <SectionRibbon family="none" label="DRAM Standards" headingLevel={2} />
        <div
            class="explore-grid"
            id="dram-grid"
            role="list"
            aria-label="DRAM standards grid"
        >
            {
                dramStandards.map((std, i) => (
                    <div
                        class:list={[
                            "explore-grid__item",
                            "reveal",
                            `explore-grid__item--${std.family}`,
                        ]}
                        data-family={std.family}
                        data-packaging={std.packaging.join(",")}
                        data-standard-id={std.id}
                        role="listitem"
                        style={`--reveal-delay: ${i * 60}ms;`}
                    >
                        <RamCard entry={std} index={i} />
                    </div>
                ))
            }
        </div>
    </section>

    <hr class="divider container" />

    <!-- ══════════════════════════════════════════════════════════════════════════ -->
    <!-- MODULE FORM FACTORS GRID -->
    <!-- ══════════════════════════════════════════════════════════════════════════ -->
    <section
        class="section-band container flow"
        aria-labelledby="modules-grid-heading"
    >
        <SectionRibbon
            family="modules"
            label="Module Form Factors"
            headingLevel={2}
        />
        <div
            class="explore-grid"
            id="module-grid"
            role="list"
            aria-label="Module form factors grid"
        >
            {
                moduleFamilyInfo.map(({ mod, families, familyClasses }, i) => (
                    <div
                        class:list={[
                            "explore-grid__item",
                            "reveal",
                            ...familyClasses,
                        ]}
                        data-family={families.join(",")}
                        data-module-id={mod.id}
                        data-compatible-standards={mod.compatibleStandards.join(
                            ",",
                        )}
                        role="listitem"
                        style={`--reveal-delay: ${i * 60}ms;`}
                    >
                        <ModuleCard entry={mod} index={i} />
                    </div>
                ))
            }
        </div>
    </section>

    <hr class="divider container" />

    <!-- ══════════════════════════════════════════════════════════════════════════ -->
    <!-- COMPARISON MATRIX -->
    <!-- ══════════════════════════════════════════════════════════════════════════ -->
    <section
        class="section-band container flow"
        aria-labelledby="matrix-section-heading"
    >
        <SectionRibbon
            family="none"
            label="Full Comparison Matrix"
            headingLevel={2}
        />
        <p>
            The complete DRAM family vs packaging type matrix, alongside all
            module electrical roles.
        </p>
        <ComparisonMatrix />
    </section>

    <!-- ══════════════════════════════════════════════════════════════════════════ -->
    <!-- CLIENT-SIDE FILTER LOGIC -->
    <!-- ══════════════════════════════════════════════════════════════════════════ -->
    <script>
        function initExploreFilters(): void {
            const dramGrid = document.getElementById("dram-grid");
            const moduleGrid = document.getElementById("module-grid");
            const statusText = document.getElementById("filter-status-text");
            const resetBtn = document.getElementById("reset-filters");

            if (!dramGrid || !moduleGrid || !statusText || !resetBtn) return;

            type FilterState = {
                family: string;
                packaging: string;
            };

            const state: FilterState = {
                family: "all",
                packaging: "all",
            };

            // All filter buttons
            const filterButtons =
                document.querySelectorAll<HTMLButtonElement>(".filter-btn");

            function updateFilters(): void {
                const dramItems = dramGrid!.querySelectorAll<HTMLElement>(
                    ".explore-grid__item",
                );
                const moduleItems = moduleGrid!.querySelectorAll<HTMLElement>(
                    ".explore-grid__item",
                );

                let visibleDramCount = 0;
                let visibleModuleCount = 0;

                // Filter DRAM standards
                dramItems.forEach((item) => {
                    const itemFamily = item.dataset.family ?? "";
                    const itemPackaging = item.dataset.packaging ?? "";
                    const families = itemFamily.split(",");
                    const packagings = itemPackaging.split(",");

                    const familyMatch =
                        state.family === "all" ||
                        families.includes(state.family);
                    const packagingMatch =
                        state.packaging === "all" ||
                        packagings.includes(state.packaging);

                    if (familyMatch && packagingMatch) {
                        item.classList.remove("explore-grid__item--dimmed");
                        item.classList.add("explore-grid__item--visible");
                        item.setAttribute("aria-hidden", "false");
                        visibleDramCount++;
                    } else {
                        item.classList.add("explore-grid__item--dimmed");
                        item.classList.remove("explore-grid__item--visible");
                        item.setAttribute("aria-hidden", "true");
                    }
                });

                // Filter modules
                moduleItems.forEach((item) => {
                    const itemFamilies = (item.dataset.family ?? "").split(",");

                    const familyMatch =
                        state.family === "all" ||
                        itemFamilies.includes(state.family);

                    // For packaging filter on modules: check if any compatible standard
                    // uses the selected packaging. We need to look at the DRAM standards.
                    let packagingMatch = true;
                    if (state.packaging !== "all") {
                        const compatibleStandardIds = (
                            item.dataset.compatibleStandards ?? ""
                        ).split(",");
                        packagingMatch = false;
                        for (const stdId of compatibleStandardIds) {
                            const stdEl = dramGrid!.querySelector<HTMLElement>(
                                `[data-standard-id="${stdId}"]`,
                            );
                            if (stdEl) {
                                const stdPackaging = (
                                    stdEl.dataset.packaging ?? ""
                                ).split(",");
                                if (stdPackaging.includes(state.packaging)) {
                                    packagingMatch = true;
                                    break;
                                }
                            }
                        }
                    }

                    if (familyMatch && packagingMatch) {
                        item.classList.remove("explore-grid__item--dimmed");
                        item.classList.add("explore-grid__item--visible");
                        item.setAttribute("aria-hidden", "false");
                        visibleModuleCount++;
                    } else {
                        item.classList.add("explore-grid__item--dimmed");
                        item.classList.remove("explore-grid__item--visible");
                        item.setAttribute("aria-hidden", "true");
                    }
                });

                // Update status text
                const totalDram = dramItems.length;
                const totalModules = moduleItems.length;

                if (state.family === "all" && state.packaging === "all") {
                    statusText!.textContent = `Showing all ${totalDram} DRAM standards and ${totalModules} module types`;
                } else {
                    const parts: string[] = [];
                    if (state.family !== "all") {
                        parts.push(`family: ${state.family.toUpperCase()}`);
                    }
                    if (state.packaging !== "all") {
                        parts.push(
                            `packaging: ${state.packaging.replace(/-/g, " ")}`,
                        );
                    }
                    statusText!.textContent = `Filtered by ${parts.join(", ")} — ${visibleDramCount} DRAM standards, ${visibleModuleCount} modules visible`;
                }

                // Show/hide reset button
                const isFiltered =
                    state.family !== "all" || state.packaging !== "all";
                resetBtn!.style.display = isFiltered ? "inline-flex" : "none";
            }

            // Button click handler
            filterButtons.forEach((btn) => {
                btn.addEventListener("click", () => {
                    const filterType = btn.dataset.filter as keyof FilterState;
                    const value = btn.dataset.value ?? "all";

                    if (!filterType) return;

                    // Update state
                    state[filterType] = value;

                    // Update aria-pressed for buttons in the same group
                    const siblings =
                        document.querySelectorAll<HTMLButtonElement>(
                            `.filter-btn[data-filter="${filterType}"]`,
                        );
                    siblings.forEach((sibling) => {
                        const isPressed = sibling.dataset.value === value;
                        sibling.setAttribute("aria-pressed", String(isPressed));
                    });

                    updateFilters();
                });
            });

            // Reset button
            resetBtn.addEventListener("click", () => {
                state.family = "all";
                state.packaging = "all";

                // Reset all button states
                filterButtons.forEach((btn) => {
                    const isAll = btn.dataset.value === "all";
                    btn.setAttribute("aria-pressed", String(isAll));
                });

                updateFilters();
            });

            // Keyboard navigation for filter groups
            const filterGroups = document.querySelectorAll(".filter-bar");
            filterGroups.forEach((group) => {
                const buttons =
                    group.querySelectorAll<HTMLButtonElement>(".filter-btn");
                buttons.forEach((btn, index) => {
                    btn.addEventListener("keydown", (e) => {
                        let targetIndex = -1;
                        if (e.key === "ArrowRight" || e.key === "ArrowDown") {
                            e.preventDefault();
                            targetIndex = (index + 1) % buttons.length;
                        } else if (
                            e.key === "ArrowLeft" ||
                            e.key === "ArrowUp"
                        ) {
                            e.preventDefault();
                            targetIndex =
                                (index - 1 + buttons.length) % buttons.length;
                        }

                        if (targetIndex >= 0) {
                            buttons[targetIndex]?.focus();
                        }
                    });
                });
            });

            // Initial state
            updateFilters();
        }

        // Run on initial load
        initExploreFilters();

        // Re-run on Astro page transitions
        document.addEventListener("astro:page-load", () => {
            initExploreFilters();
        });
    </script>
</BaseLayout>

<style>
    /* ─── Explore hero ──────────────────────────────────────────────────────────── */
    .explore-hero {
        padding-top: var(--space-20);
    }

    .explore-hero__title {
        font-size: var(--text-5xl);
        font-weight: 800;
        letter-spacing: -0.03em;
        line-height: 1.1;
        background: linear-gradient(
            135deg,
            var(--cyan-300) 0%,
            var(--teal-300) 33%,
            var(--amber-300) 66%,
            var(--violet-300) 100%
        );
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .explore-hero__subtitle {
        font-size: var(--text-xl);
        color: var(--ink-200);
        max-inline-size: 55ch;
        line-height: 1.6;
    }

    /* ─── Filter section ────────────────────────────────────────────────────────── */
    .filter-section {
        display: flex;
        flex-direction: column;
        gap: var(--space-6);
    }

    .filter-group {
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
    }

    .filter-group__label {
        font-family: var(--font-display);
        font-size: var(--text-xs);
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--ink-300);
    }

    /* ─── Filter status ────────────────────────────────────────────────────────── */
    .filter-status {
        display: flex;
        align-items: center;
        gap: var(--space-4);
        padding: var(--space-3) var(--space-4);
        background: var(--surface);
        border: 1px solid var(--surface-stroke);
        border-radius: var(--radius-md);
    }

    .filter-status__text {
        font-size: var(--text-sm);
        color: var(--ink-200);
        flex: 1;
    }

    .filter-reset-btn {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        padding: var(--space-2) var(--space-3);
        border: 1px solid var(--surface-stroke);
        border-radius: 9999px;
        background: transparent;
        color: var(--ink-200);
        font-family: var(--font-body);
        font-size: var(--text-xs);
        font-weight: 500;
        cursor: pointer;
        transition:
            background var(--duration-fast) var(--ease-out-expo),
            color var(--duration-fast) var(--ease-out-expo),
            border-color var(--duration-fast) var(--ease-out-expo);
        white-space: nowrap;
    }

    .filter-reset-btn:hover {
        background: rgba(255, 255, 255, 0.06);
        color: var(--ink-50);
        border-color: var(--ink-400);
    }

    /* ─── Explore grid ─────────────────────────────────────────────────────────── */
    .explore-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
        gap: var(--space-6);
    }

    /* ─── Grid item states ─────────────────────────────────────────────────────── */
    .explore-grid__item {
        transition:
            opacity var(--duration-normal) var(--ease-out-expo),
            transform var(--duration-normal) var(--ease-out-expo),
            filter var(--duration-normal) var(--ease-out-expo);
    }

    .explore-grid__item--visible {
        opacity: 1;
        transform: scale(1);
        filter: none;
    }

    .explore-grid__item--dimmed {
        opacity: 0.15;
        transform: scale(0.98);
        filter: grayscale(0.5);
        pointer-events: none;
    }

    /* ─── Reveal animation for grid items ───────────────────────────────────────── */
    .reveal {
        opacity: 0;
        transform: translateY(12px);
        transition:
            opacity var(--duration-slow) var(--ease-out-expo),
            transform var(--duration-slow) var(--ease-out-expo);
        transition-delay: var(--reveal-delay, 0ms);
    }

    .reveal.revealed {
        opacity: 1;
        transform: translateY(0);
    }

    /* Dimmed items skip reveal animation */
    .explore-grid__item--dimmed.revealed {
        opacity: 0.15;
        transform: scale(0.98);
    }

    /* ─── Responsive ───────────────────────────────────────────────────────────── */
    @media (max-width: 768px) {
        .explore-hero__title {
            font-size: var(--text-4xl);
        }

        .explore-hero__subtitle {
            font-size: var(--text-lg);
        }

        .explore-grid {
            grid-template-columns: 1fr;
            gap: var(--space-4);
        }

        .filter-bar {
            gap: var(--space-1);
        }

        .filter-btn {
            padding: var(--space-1) var(--space-3);
            font-size: var(--text-xs);
        }

        .filter-status {
            flex-direction: column;
            align-items: flex-start;
            gap: var(--space-2);
        }
    }

    @media (max-width: 480px) {
        .filter-bar {
            flex-wrap: wrap;
        }
    }

    /* ─── Reduced motion ───────────────────────────────────────────────────────── */
    @media (prefers-reduced-motion: reduce) {
        .explore-grid__item,
        .explore-grid__item--visible,
        .explore-grid__item--dimmed {
            transition: none;
        }

        .explore-grid__item--dimmed {
            transform: none;
        }

        .reveal {
            opacity: 1;
            transform: none;
            transition: none;
        }

        .explore-grid__item--dimmed.revealed {
            transform: none;
        }
    }
</style>
