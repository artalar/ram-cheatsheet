---
/**
 * HeroMural — full-width composed SVG scene showing the memory landscape.
 *
 * Abstract CPU, GPU, and accelerator blocks connected to their respective
 * memory types via bus/lane lines. Decorative only (meaning conveyed by
 * paired text). Respects prefers-reduced-motion for any subtle animation.
 */
---

<div class="hero-mural" aria-hidden="true">
  <svg
    class="hero-mural__svg"
    viewBox="0 0 1280 480"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    preserveAspectRatio="xMidYMid slice"
    role="img"
  >
    <defs>
      <!-- Glow filters -->
      <filter id="glow-cyan" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="6" result="blur" />
        <feMerge>
          <feMergeNode in="blur" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>
      <filter id="glow-amber" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="6" result="blur" />
        <feMerge>
          <feMergeNode in="blur" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>
      <filter id="glow-violet" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="6" result="blur" />
        <feMerge>
          <feMergeNode in="blur" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>
      <filter id="glow-teal" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="5" result="blur" />
        <feMerge>
          <feMergeNode in="blur" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>

      <!-- Grid pattern for background -->
      <pattern id="dot-grid" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
        <circle cx="12" cy="12" r="0.6" fill="rgba(148,163,184,0.12)" />
      </pattern>
    </defs>

    <!-- Background grid -->
    <rect width="1280" height="480" fill="url(#dot-grid)" />

    <!-- ── CPU Block (left-center) ── -->
    <g class="hero-mural__block hero-mural__block--cpu">
      <rect x="80" y="140" width="100" height="120" rx="8" stroke="rgba(6,182,212,0.4)" stroke-width="1.5" fill="rgba(6,182,212,0.05)" />
      <rect x="95" y="155" width="70" height="90" rx="4" stroke="rgba(6,182,212,0.25)" stroke-width="1" fill="none" />
      <!-- CPU die detail -->
      <line x1="95" y1="185" x2="165" y2="185" stroke="rgba(6,182,212,0.15)" stroke-width="0.5" />
      <line x1="95" y1="215" x2="165" y2="215" stroke="rgba(6,182,212,0.15)" stroke-width="0.5" />
      <line x1="130" y1="155" x2="130" y2="245" stroke="rgba(6,182,212,0.15)" stroke-width="0.5" />
      <!-- Label -->
      <text x="130" y="280" text-anchor="middle" font-size="11" fill="rgba(6,182,212,0.6)" font-family="monospace" font-weight="600" letter-spacing="0.08em">CPU</text>

      <!-- Bond pads top -->
      <rect x="95" y="134" width="4" height="4" rx="0.5" fill="rgba(6,182,212,0.3)" />
      <rect x="108" y="134" width="4" height="4" rx="0.5" fill="rgba(6,182,212,0.3)" />
      <rect x="121" y="134" width="4" height="4" rx="0.5" fill="rgba(6,182,212,0.3)" />
      <rect x="148" y="134" width="4" height="4" rx="0.5" fill="rgba(6,182,212,0.3)" />
      <rect x="161" y="134" width="4" height="4" rx="0.5" fill="rgba(6,182,212,0.3)" />
    </g>

    <!-- ── DIMM modules (CPU memory) ── -->
    <g class="hero-mural__memory hero-mural__memory--dimm">
      <!-- DIMM 1 -->
      <rect x="260" y="120" width="90" height="22" rx="2" stroke="rgba(6,182,212,0.35)" stroke-width="1.2" fill="rgba(6,182,212,0.04)" />
      <rect x="265" y="124" width="12" height="14" rx="1" stroke="rgba(6,182,212,0.2)" stroke-width="0.8" fill="none" />
      <rect x="281" y="124" width="12" height="14" rx="1" stroke="rgba(6,182,212,0.2)" stroke-width="0.8" fill="none" />
      <rect x="297" y="124" width="12" height="14" rx="1" stroke="rgba(6,182,212,0.2)" stroke-width="0.8" fill="none" />
      <rect x="313" y="124" width="12" height="14" rx="1" stroke="rgba(6,182,212,0.2)" stroke-width="0.8" fill="none" />
      <rect x="329" y="124" width="12" height="14" rx="1" stroke="rgba(6,182,212,0.2)" stroke-width="0.8" fill="none" />
      <!-- DIMM 2 -->
      <rect x="260" y="155" width="90" height="22" rx="2" stroke="rgba(6,182,212,0.35)" stroke-width="1.2" fill="rgba(6,182,212,0.04)" />
      <rect x="265" y="159" width="12" height="14" rx="1" stroke="rgba(6,182,212,0.2)" stroke-width="0.8" fill="none" />
      <rect x="281" y="159" width="12" height="14" rx="1" stroke="rgba(6,182,212,0.2)" stroke-width="0.8" fill="none" />
      <rect x="297" y="159" width="12" height="14" rx="1" stroke="rgba(6,182,212,0.2)" stroke-width="0.8" fill="none" />
      <rect x="313" y="159" width="12" height="14" rx="1" stroke="rgba(6,182,212,0.2)" stroke-width="0.8" fill="none" />
      <rect x="329" y="159" width="12" height="14" rx="1" stroke="rgba(6,182,212,0.2)" stroke-width="0.8" fill="none" />
      <!-- DIMM label -->
      <text x="305" y="198" text-anchor="middle" font-size="9" fill="rgba(6,182,212,0.45)" font-family="monospace" letter-spacing="0.06em">DDR5</text>
    </g>

    <!-- ── Bus lines: CPU → DIMM ── -->
    <g class="hero-mural__bus hero-mural__bus--ddr">
      <line x1="180" y1="165" x2="258" y2="133" stroke="rgba(6,182,212,0.2)" stroke-width="1" />
      <line x1="180" y1="180" x2="258" y2="166" stroke="rgba(6,182,212,0.2)" stroke-width="1" />
      <line x1="180" y1="195" x2="258" y2="133" stroke="rgba(6,182,212,0.12)" stroke-width="0.5" stroke-dasharray="3 3" />
      <line x1="180" y1="210" x2="258" y2="166" stroke="rgba(6,182,212,0.12)" stroke-width="0.5" stroke-dasharray="3 3" />
      <!-- Arrow hints -->
      <polygon points="254,131 260,133 254,135" fill="rgba(6,182,212,0.3)" />
      <polygon points="254,164 260,166 254,168" fill="rgba(6,182,212,0.3)" />
    </g>

    <!-- ── GPU Block (center) ── -->
    <g class="hero-mural__block hero-mural__block--gpu">
      <rect x="500" y="110" width="130" height="150" rx="10" stroke="rgba(245,158,11,0.4)" stroke-width="1.5" fill="rgba(245,158,11,0.04)" />
      <rect x="515" y="125" width="100" height="120" rx="4" stroke="rgba(245,158,11,0.2)" stroke-width="1" fill="none" />
      <!-- GPU die detail grid -->
      <line x1="515" y1="155" x2="615" y2="155" stroke="rgba(245,158,11,0.1)" stroke-width="0.5" />
      <line x1="515" y1="185" x2="615" y2="185" stroke="rgba(245,158,11,0.1)" stroke-width="0.5" />
      <line x1="515" y1="215" x2="615" y2="215" stroke="rgba(245,158,11,0.1)" stroke-width="0.5" />
      <line x1="548" y1="125" x2="548" y2="245" stroke="rgba(245,158,11,0.1)" stroke-width="0.5" />
      <line x1="582" y1="125" x2="582" y2="245" stroke="rgba(245,158,11,0.1)" stroke-width="0.5" />
      <!-- Label -->
      <text x="565" y="280" text-anchor="middle" font-size="11" fill="rgba(245,158,11,0.6)" font-family="monospace" font-weight="600" letter-spacing="0.08em">GPU</text>

      <!-- Bond pads right side -->
      <rect x="626" y="130" width="4" height="4" rx="0.5" fill="rgba(245,158,11,0.3)" />
      <rect x="626" y="148" width="4" height="4" rx="0.5" fill="rgba(245,158,11,0.3)" />
      <rect x="626" y="166" width="4" height="4" rx="0.5" fill="rgba(245,158,11,0.3)" />
      <rect x="626" y="184" width="4" height="4" rx="0.5" fill="rgba(245,158,11,0.3)" />
      <rect x="626" y="202" width="4" height="4" rx="0.5" fill="rgba(245,158,11,0.3)" />
      <rect x="626" y="220" width="4" height="4" rx="0.5" fill="rgba(245,158,11,0.3)" />
      <rect x="626" y="238" width="4" height="4" rx="0.5" fill="rgba(245,158,11,0.3)" />
    </g>

    <!-- ── GDDR chips (GPU memory, right of GPU) ── -->
    <g class="hero-mural__memory hero-mural__memory--gddr">
      <!-- GDDR chip cluster -->
      <rect x="700" y="115" width="50" height="40" rx="4" stroke="rgba(245,158,11,0.3)" stroke-width="1.2" fill="rgba(245,158,11,0.04)" />
      <rect x="760" y="115" width="50" height="40" rx="4" stroke="rgba(245,158,11,0.3)" stroke-width="1.2" fill="rgba(245,158,11,0.04)" />
      <rect x="700" y="170" width="50" height="40" rx="4" stroke="rgba(245,158,11,0.3)" stroke-width="1.2" fill="rgba(245,158,11,0.04)" />
      <rect x="760" y="170" width="50" height="40" rx="4" stroke="rgba(245,158,11,0.3)" stroke-width="1.2" fill="rgba(245,158,11,0.04)" />
      <rect x="700" y="225" width="50" height="40" rx="4" stroke="rgba(245,158,11,0.3)" stroke-width="1.2" fill="rgba(245,158,11,0.04)" />
      <rect x="760" y="225" width="50" height="40" rx="4" stroke="rgba(245,158,11,0.3)" stroke-width="1.2" fill="rgba(245,158,11,0.04)" />
      <!-- Bond pads on chips -->
      <circle cx="710" cy="125" r="1.5" fill="rgba(245,158,11,0.2)" />
      <circle cx="720" cy="125" r="1.5" fill="rgba(245,158,11,0.2)" />
      <circle cx="730" cy="125" r="1.5" fill="rgba(245,158,11,0.2)" />
      <circle cx="770" cy="125" r="1.5" fill="rgba(245,158,11,0.2)" />
      <circle cx="780" cy="125" r="1.5" fill="rgba(245,158,11,0.2)" />
      <circle cx="790" cy="125" r="1.5" fill="rgba(245,158,11,0.2)" />
      <!-- Label -->
      <text x="755" y="283" text-anchor="middle" font-size="9" fill="rgba(245,158,11,0.45)" font-family="monospace" letter-spacing="0.06em">GDDR6/6X/7</text>
    </g>

    <!-- ── Bus lines: GPU → GDDR (wide bus) ── -->
    <g class="hero-mural__bus hero-mural__bus--gddr">
      <line x1="630" y1="135" x2="698" y2="135" stroke="rgba(245,158,11,0.2)" stroke-width="1" />
      <line x1="630" y1="153" x2="698" y2="153" stroke="rgba(245,158,11,0.2)" stroke-width="1" />
      <line x1="630" y1="171" x2="698" y2="171" stroke="rgba(245,158,11,0.2)" stroke-width="1" />
      <line x1="630" y1="189" x2="698" y2="189" stroke="rgba(245,158,11,0.2)" stroke-width="1" />
      <line x1="630" y1="207" x2="698" y2="207" stroke="rgba(245,158,11,0.2)" stroke-width="1" />
      <line x1="630" y1="225" x2="698" y2="225" stroke="rgba(245,158,11,0.2)" stroke-width="1" />
      <line x1="630" y1="243" x2="698" y2="243" stroke="rgba(245,158,11,0.2)" stroke-width="1" />
      <!-- Wide bus suggestion: fill between outer lines -->
      <rect x="630" y="135" width="68" height="108" fill="rgba(245,158,11,0.02)" />
    </g>

    <!-- ── Accelerator Block (right) ── -->
    <g class="hero-mural__block hero-mural__block--accel">
      <rect x="950" y="120" width="120" height="140" rx="10" stroke="rgba(139,92,246,0.4)" stroke-width="1.5" fill="rgba(139,92,246,0.04)" />
      <rect x="965" y="135" width="90" height="110" rx="4" stroke="rgba(139,92,246,0.2)" stroke-width="1" fill="none" />
      <!-- Accelerator die detail -->
      <line x1="965" y1="170" x2="1055" y2="170" stroke="rgba(139,92,246,0.1)" stroke-width="0.5" />
      <line x1="965" y1="205" x2="1055" y2="205" stroke="rgba(139,92,246,0.1)" stroke-width="0.5" />
      <line x1="1010" y1="135" x2="1010" y2="245" stroke="rgba(139,92,246,0.1)" stroke-width="0.5" />
      <!-- Label -->
      <text x="1010" y="280" text-anchor="middle" font-size="11" fill="rgba(139,92,246,0.6)" font-family="monospace" font-weight="600" letter-spacing="0.06em">ACCELERATOR</text>
    </g>

    <!-- ── HBM Stack (on interposer, right side) ── -->
    <g class="hero-mural__memory hero-mural__memory--hbm">
      <!-- Interposer base -->
      <rect x="1120" y="230" width="120" height="16" rx="2" stroke="rgba(139,92,246,0.3)" stroke-width="1" fill="rgba(139,92,246,0.03)" />
      <text x="1180" y="242" text-anchor="middle" font-size="6" fill="rgba(139,92,246,0.35)" font-family="monospace">INTERPOSER</text>

      <!-- HBM stack 1 -->
      <rect x="1130" y="70" width="36" height="160" rx="3" stroke="rgba(139,92,246,0.35)" stroke-width="1.2" fill="rgba(139,92,246,0.04)" />
      <line x1="1130" y1="102" x2="1166" y2="102" stroke="rgba(139,92,246,0.15)" stroke-width="0.5" />
      <line x1="1130" y1="134" x2="1166" y2="134" stroke="rgba(139,92,246,0.15)" stroke-width="0.5" />
      <line x1="1130" y1="166" x2="1166" y2="166" stroke="rgba(139,92,246,0.15)" stroke-width="0.5" />
      <line x1="1130" y1="198" x2="1166" y2="198" stroke="rgba(139,92,246,0.15)" stroke-width="0.5" />
      <!-- TSV dots -->
      <circle cx="1140" cy="86" r="1.2" fill="rgba(139,92,246,0.3)" />
      <circle cx="1148" cy="86" r="1.2" fill="rgba(139,92,246,0.3)" />
      <circle cx="1156" cy="86" r="1.2" fill="rgba(139,92,246,0.3)" />
      <circle cx="1140" cy="118" r="1.2" fill="rgba(139,92,246,0.25)" />
      <circle cx="1148" cy="118" r="1.2" fill="rgba(139,92,246,0.25)" />
      <circle cx="1156" cy="118" r="1.2" fill="rgba(139,92,246,0.25)" />

      <!-- HBM stack 2 -->
      <rect x="1180" y="90" width="36" height="140" rx="3" stroke="rgba(139,92,246,0.35)" stroke-width="1.2" fill="rgba(139,92,246,0.04)" />
      <line x1="1180" y1="118" x2="1216" y2="118" stroke="rgba(139,92,246,0.15)" stroke-width="0.5" />
      <line x1="1180" y1="146" x2="1216" y2="146" stroke="rgba(139,92,246,0.15)" stroke-width="0.5" />
      <line x1="1180" y1="174" x2="1216" y2="174" stroke="rgba(139,92,246,0.15)" stroke-width="0.5" />
      <line x1="1180" y1="202" x2="1216" y2="202" stroke="rgba(139,92,246,0.15)" stroke-width="0.5" />
      <!-- TSV dots -->
      <circle cx="1190" cy="104" r="1.2" fill="rgba(139,92,246,0.3)" />
      <circle cx="1198" cy="104" r="1.2" fill="rgba(139,92,246,0.3)" />
      <circle cx="1206" cy="104" r="1.2" fill="rgba(139,92,246,0.3)" />

      <!-- Label -->
      <text x="1175" y="262" text-anchor="middle" font-size="9" fill="rgba(139,92,246,0.45)" font-family="monospace" letter-spacing="0.06em">HBM3/HBM3E</text>
    </g>

    <!-- ── Bus lines: Accelerator → HBM ── -->
    <g class="hero-mural__bus hero-mural__bus--hbm">
      <line x1="1070" y1="160" x2="1128" y2="160" stroke="rgba(139,92,246,0.2)" stroke-width="1" />
      <line x1="1070" y1="180" x2="1128" y2="180" stroke="rgba(139,92,246,0.2)" stroke-width="1" />
      <line x1="1070" y1="200" x2="1128" y2="200" stroke="rgba(139,92,246,0.2)" stroke-width="1" />
      <line x1="1070" y1="220" x2="1128" y2="220" stroke="rgba(139,92,246,0.2)" stroke-width="1" />
      <!-- Through interposer to stacks -->
      <line x1="1148" y1="230" x2="1148" y2="212" stroke="rgba(139,92,246,0.15)" stroke-width="0.8" />
      <line x1="1198" y1="230" x2="1198" y2="212" stroke="rgba(139,92,246,0.15)" stroke-width="0.8" />
    </g>

    <!-- ── Mobile/SoC (bottom-left) ── -->
    <g class="hero-mural__block hero-mural__block--soc">
      <rect x="80" y="340" width="180" height="80" rx="8" stroke="rgba(20,184,166,0.35)" stroke-width="1.5" fill="rgba(20,184,166,0.04)" />
      <!-- CPU section -->
      <rect x="90" y="350" width="50" height="60" rx="3" stroke="rgba(20,184,166,0.2)" stroke-width="0.8" fill="none" />
      <text x="115" y="384" text-anchor="middle" font-size="7" fill="rgba(20,184,166,0.4)" font-family="monospace">CPU</text>
      <!-- GPU section -->
      <rect x="150" y="350" width="50" height="60" rx="3" stroke="rgba(20,184,166,0.2)" stroke-width="0.8" fill="none" />
      <text x="175" y="384" text-anchor="middle" font-size="7" fill="rgba(20,184,166,0.4)" font-family="monospace">GPU</text>
      <!-- Shared memory block -->
      <rect x="290" y="355" width="60" height="50" rx="4" stroke="rgba(20,184,166,0.3)" stroke-width="1.2" fill="rgba(20,184,166,0.04)" />
      <text x="320" y="384" text-anchor="middle" font-size="7" fill="rgba(20,184,166,0.45)" font-family="monospace">LPDDR</text>
      <!-- Connection lines -->
      <line x1="260" y1="370" x2="288" y2="370" stroke="rgba(20,184,166,0.2)" stroke-width="1" />
      <line x1="260" y1="390" x2="288" y2="390" stroke="rgba(20,184,166,0.2)" stroke-width="1" />
      <!-- Shared pool indication -->
      <rect x="258" y="358" width="34" height="44" fill="none" stroke="rgba(20,184,166,0.12)" stroke-width="0.5" stroke-dasharray="3 3" rx="2" />
      <!-- Label -->
      <text x="170" y="435" text-anchor="middle" font-size="9" fill="rgba(20,184,166,0.45)" font-family="monospace" letter-spacing="0.06em">SoC — SHARED MEMORY</text>
    </g>

    <!-- ── Decorative floating chip silhouettes ── -->
    <g opacity="0.06">
      <!-- Top-right corner chip -->
      <rect x="1150" y="20" width="60" height="60" rx="6" stroke="currentColor" stroke-width="1.5" />
      <rect x="1162" y="32" width="36" height="36" rx="2" stroke="currentColor" stroke-width="0.8" />

      <!-- Bottom-right dot pattern -->
      <circle cx="1100" cy="420" r="4" fill="currentColor" />
      <circle cx="1116" cy="420" r="4" fill="currentColor" />
      <circle cx="1132" cy="420" r="4" fill="currentColor" />
      <circle cx="1100" cy="436" r="4" fill="currentColor" />
      <circle cx="1116" cy="436" r="4" fill="currentColor" />
      <circle cx="1132" cy="436" r="4" fill="currentColor" />
      <circle cx="1100" cy="452" r="4" fill="currentColor" />
      <circle cx="1116" cy="452" r="4" fill="currentColor" />
      <circle cx="1132" cy="452" r="4" fill="currentColor" />

      <!-- Left side horizontal lines (bus lanes) -->
      <line x1="10" y1="300" x2="60" y2="300" stroke="currentColor" stroke-width="1" />
      <line x1="10" y1="308" x2="60" y2="308" stroke="currentColor" stroke-width="1" />
      <line x1="10" y1="316" x2="60" y2="316" stroke="currentColor" stroke-width="1" />
    </g>

    <!-- ── Section labels on the scene ── -->
    <g class="hero-mural__labels" opacity="0.18">
      <text x="220" y="100" font-size="8" fill="rgba(6,182,212,0.6)" font-family="monospace" letter-spacing="0.15em" text-transform="uppercase">HOST MEMORY CHANNEL</text>
      <text x="640" y="100" font-size="8" fill="rgba(245,158,11,0.6)" font-family="monospace" letter-spacing="0.15em">WIDE GPU BUS</text>
      <text x="1020" y="100" font-size="8" fill="rgba(139,92,246,0.6)" font-family="monospace" letter-spacing="0.15em">ON-PACKAGE</text>
    </g>
  </svg>
</div>

<style>
  .hero-mural {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: 1px solid var(--surface-stroke);
    background: rgba(10, 14, 26, 0.5);
  }

  .hero-mural__svg {
    display: block;
    width: 100%;
    height: auto;
    min-height: 280px;
  }

  /* Subtle entrance animation */
  .hero-mural__block,
  .hero-mural__memory,
  .hero-mural__bus {
    opacity: 0;
    animation: mural-fade-in 800ms var(--ease-out-expo) forwards;
  }

  .hero-mural__block--cpu { animation-delay: 100ms; }
  .hero-mural__bus--ddr { animation-delay: 200ms; }
  .hero-mural__memory--dimm { animation-delay: 300ms; }
  .hero-mural__block--gpu { animation-delay: 400ms; }
  .hero-mural__bus--gddr { animation-delay: 500ms; }
  .hero-mural__memory--gddr { animation-delay: 600ms; }
  .hero-mural__block--accel { animation-delay: 700ms; }
  .hero-mural__bus--hbm { animation-delay: 800ms; }
  .hero-mural__memory--hbm { animation-delay: 900ms; }
  .hero-mural__block--soc { animation-delay: 1000ms; }

  .hero-mural__labels {
    opacity: 0;
    animation: mural-fade-in 600ms var(--ease-out-expo) 1200ms forwards;
