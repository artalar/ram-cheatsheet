---
import type { DramStandard, DramFamily } from '../content/ram-types';

interface Props {
  readonly entry: DramStandard;
  readonly index?: number;
}

const { entry, index = 0 } = Astro.props;

const familyClass: Record<DramFamily, string> = {
  ddr: 'ddr',
  lpddr: 'lpddr',
  gddr: 'gddr',
  hbm: 'hbm',
};

const family = familyClass[entry.family];
---

<article
  class:list={['ram-card panel hover-lift', `ram-card--${family}`]}
  style={`--reveal-delay: ${index * 80}ms;`}
>
  <div class={`color-stripe color-stripe--${family}`}></div>

  <div class="motif-watermark" aria-hidden="true">
    {entry.motif === 'chip' && (
      <svg viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect x="20" y="20" width="80" height="80" rx="8" stroke="currentColor" stroke-width="1.5" />
        <rect x="35" y="35" width="50" height="50" rx="4" stroke="currentColor" stroke-width="1" />
        <!-- Bond pads top -->
        <rect x="30" y="16" width="6" height="6" rx="1" fill="currentColor" />
        <rect x="42" y="16" width="6" height="6" rx="1" fill="currentColor" />
        <rect x="54" y="16" width="6" height="6" rx="1" fill="currentColor" />
        <rect x="66" y="16" width="6" height="6" rx="1" fill="currentColor" />
        <rect x="78" y="16" width="6" height="6" rx="1" fill="currentColor" />
        <!-- Bond pads bottom -->
        <rect x="30" y="98" width="6" height="6" rx="1" fill="currentColor" />
        <rect x="42" y="98" width="6" height="6" rx="1" fill="currentColor" />
        <rect x="54" y="98" width="6" height="6" rx="1" fill="currentColor" />
        <rect x="66" y="98" width="6" height="6" rx="1" fill="currentColor" />
        <rect x="78" y="98" width="6" height="6" rx="1" fill="currentColor" />
        <!-- Bond pads left -->
        <rect x="16" y="30" width="6" height="6" rx="1" fill="currentColor" />
        <rect x="16" y="42" width="6" height="6" rx="1" fill="currentColor" />
        <rect x="16" y="54" width="6" height="6" rx="1" fill="currentColor" />
        <rect x="16" y="66" width="6" height="6" rx="1" fill="currentColor" />
        <rect x="16" y="78" width="6" height="6" rx="1" fill="currentColor" />
        <!-- Bond pads right -->
        <rect x="98" y="30" width="6" height="6" rx="1" fill="currentColor" />
        <rect x="98" y="42" width="6" height="6" rx="1" fill="currentColor" />
        <rect x="98" y="54" width="6" height="6" rx="1" fill="currentColor" />
        <rect x="98" y="66" width="6" height="6" rx="1" fill="currentColor" />
        <rect x="98" y="78" width="6" height="6" rx="1" fill="currentColor" />
      </svg>
    )}
    {entry.motif === 'bus' && (
      <svg viewBox="0 0 160 120" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Host block -->
        <rect x="10" y="30" width="40" height="60" rx="6" stroke="currentColor" stroke-width="1.5" />
        <text x="30" y="65" text-anchor="middle" font-size="10" fill="currentColor" font-family="monospace">GPU</text>
        <!-- Bus lines -->
        <line x1="50" y1="38" x2="110" y2="38" stroke="currentColor" stroke-width="1" stroke-dasharray="4 2" />
        <line x1="50" y1="48" x2="110" y2="48" stroke="currentColor" stroke-width="1" stroke-dasharray="4 2" />
        <line x1="50" y1="58" x2="110" y2="58" stroke="currentColor" stroke-width="1" stroke-dasharray="4 2" />
        <line x1="50" y1="68" x2="110" y2="68" stroke="currentColor" stroke-width="1" stroke-dasharray="4 2" />
        <line x1="50" y1="78" x2="110" y2="78" stroke="currentColor" stroke-width="1" stroke-dasharray="4 2" />
        <!-- Memory block -->
        <rect x="110" y="30" width="40" height="60" rx="6" stroke="currentColor" stroke-width="1.5" />
        <text x="130" y="65" text-anchor="middle" font-size="8" fill="currentColor" font-family="monospace">VRAM</text>
        <!-- Direction arrows -->
        <polygon points="105,36 110,38 105,40" fill="currentColor" />
        <polygon points="55,76 50,78 55,80" fill="currentColor" />
      </svg>
    )}
    {entry.motif === 'stack' && (
      <svg viewBox="0 0 120 140" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Stacked DRAM layers -->
        <rect x="25" y="15" width="70" height="16" rx="3" stroke="currentColor" stroke-width="1.2" />
        <rect x="25" y="35" width="70" height="16" rx="3" stroke="currentColor" stroke-width="1.2" />
        <rect x="25" y="55" width="70" height="16" rx="3" stroke="currentColor" stroke-width="1.2" />
        <rect x="25" y="75" width="70" height="16" rx="3" stroke="currentColor" stroke-width="1.2" />
        <rect x="25" y="95" width="70" height="16" rx="3" stroke="currentColor" stroke-width="1.2" />
        <!-- TSV vertical connectors -->
        <line x1="40" y1="15" x2="40" y2="111" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2 2" />
        <line x1="60" y1="15" x2="60" y2="111" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2 2" />
        <line x1="80" y1="15" x2="80" y2="111" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2 2" />
        <!-- Base / interposer -->
        <rect x="15" y="115" width="90" height="12" rx="2" stroke="currentColor" stroke-width="1" />
        <text x="60" y="124" text-anchor="middle" font-size="7" fill="currentColor" font-family="monospace">interposer</text>
      </svg>
    )}
  </div>

  <div class="ram-card__content">
    <div class="ram-card__header">
      <span class:list={['ram-card__badge acronym', `ram-card__badge--${family}`]}>
        {entry.acronym}
      </span>
      {entry.jedecRef && (
        <span class="ram-card__jedec">{entry.jedecRef}</span>
      )}
    </div>

    <p class="ram-card__role">{entry.role}</p>

    <p class="ram-card__description">{entry.description}</p>

    <div class="ram-card__tags" role="list" aria-label="Use cases">
      {entry.useTags.map((tag) => (
        <span class:list={['chip', `chip--${family}`]} role="listitem">{tag}</span>
      ))}
      {entry.packaging.map((pkg) => (
        <span class="chip" role="listitem">{pkg.replace(/-/g, ' ')}</span>
      ))}
    </div>
  </div>
</article>

<style>
  .ram-card {
    position: relative;
    padding-left: var(--space-8);
    overflow: hidden;
    isolation: isolate;
  }

  .ram-card__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .ram-card__header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .ram-card__badge {
    display: inline-flex;
    align-items: center;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-md);
    font-size: var(--text-lg);
    letter-spacing: 0.06em;
    line-height: 1;
  }

  .ram-card__badge--ddr {
    background: rgba(6, 182, 212, 0.12);
    color: var(--cyan-300);
    border: 1px solid rgba(6, 182, 212, 0.3);
  }

  .ram-card__badge--lpddr {
    background: rgba(20, 184, 166, 0.12);
    color: var(--teal-300);
    border: 1px solid rgba(20, 184, 166, 0.3);
  }

  .ram-card__badge--gddr {
    background: rgba(245, 158, 11, 0.12);
    color: var(--amber-300);
    border: 1px solid rgba(245, 158, 11, 0.3);
  }

  .ram-card__badge--hbm {
    background: rgba(139, 92, 246, 0.12);
    color: var(--violet-300);
    border: 1px solid rgba(139, 92, 246, 0.3);
  }

  .ram-card__jedec {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-300);
    letter-spacing: 0.03em;
  }

  .ram-card__role {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--ink-50);
    max-inline-size: none;
    line-height: 1.4;
  }

  .ram-card__description {
    font-size: var(--text-sm);
    color: var(--ink-200);
    line-height: 1.6;
    max-inline-size: 60ch;
  }

  .ram-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block-start: var(--space-1);
  }
</style>
