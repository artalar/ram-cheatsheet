---
import type { ModuleStandard, ModuleElectricalRole } from '../content/ram-types';

interface Props {
  readonly entry: ModuleStandard;
  readonly index?: number;
}

const { entry, index = 0 } = Astro.props;

const roleColors: Record<ModuleElectricalRole, { bg: string; border: string; text: string; stripe: string }> = {
  unbuffered: {
    bg: 'rgba(6, 182, 212, 0.12)',
    border: 'rgba(6, 182, 212, 0.3)',
    text: 'var(--cyan-300)',
    stripe: 'var(--cyan-500)',
  },
  registered: {
    bg: 'rgba(139, 92, 246, 0.12)',
    border: 'rgba(139, 92, 246, 0.3)',
    text: 'var(--violet-300)',
    stripe: 'var(--violet-500)',
  },
  'load-reduced': {
    bg: 'rgba(217, 70, 239, 0.12)',
    border: 'rgba(217, 70, 239, 0.3)',
    text: 'var(--magenta-300)',
    stripe: 'var(--magenta-500)',
  },
  'clocked-unbuffered': {
    bg: 'rgba(245, 158, 11, 0.12)',
    border: 'rgba(245, 158, 11, 0.3)',
    text: 'var(--amber-300)',
    stripe: 'var(--amber-500)',
  },
  'multiplexed-rank': {
    bg: 'rgba(239, 68, 68, 0.12)',
    border: 'rgba(239, 68, 68, 0.3)',
    text: '#fca5a5',
    stripe: '#ef4444',
  },
};

const colors = roleColors[entry.moduleRole];

// Determine silhouette aspect ratio based on form factor
const isSoDimm = entry.formFactor.includes('SO-DIMM');
const isCamm = entry.formFactor.includes('CAMM');
const isFullDimm = entry.formFactor.includes('133.35');
---

<article
  class:list={['module-card panel hover-lift']}
  style={`--reveal-delay: ${index * 80}ms; --role-stripe: ${colors.stripe};`}
>
  <div class="module-card__stripe" aria-hidden="true"></div>

  <div class="motif-watermark" aria-hidden="true">
    {isFullDimm && (
      <svg viewBox="0 0 200 60" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Full-size DIMM outline -->
        <rect x="2" y="8" width="196" height="40" rx="3" stroke="currentColor" stroke-width="1.2" />
        <!-- Notch -->
        <rect x="72" y="6" width="12" height="6" rx="1" fill="var(--ink-900)" stroke="currentColor" stroke-width="0.8" />
        <!-- Edge connector fingers -->
        <rect x="10" y="48" width="4" height="8" rx="0.5" stroke="currentColor" stroke-width="0.6" fill="none" />
        <rect x="18" y="48" width="4" height="8" rx="0.5" stroke="currentColor" stroke-width="0.6" fill="none" />
        <rect x="26" y="48" width="4" height="8" rx="0.5" stroke="currentColor" stroke-width="0.6" fill="none" />
        <rect x="34" y="48" width="4" height="8" rx="0.5" stroke="currentColor" stroke-width="0.6" fill="none" />
        <rect x="42" y="48" width="4" height="8" rx="0.5" stroke="currentColor" stroke-width="0.6" fill="none" />
        <rect x="50" y="48" width="4" height="8" rx="0.5" stroke="currentColor" stroke-width="0.6" fill="none" />
        <rect x="58" y="48" width="4" height="8" rx="0.5" stroke="currentColor" stroke-width="0.6" fill="none" />
        <rect x="84" y="48" width="4" height="8" rx="0.5" stroke="currentColor" stroke-width="0.6" fill="none" />
        <rect x="92" y="48" width="4" height="8" rx="0.5" stroke="currentColor" stroke-width="0.6" fill="none" />
        <rect x="100" y="48" width="4" height="8" rx="0.5" stroke="currentColor" stroke-width="0.6" fill="none" />
        <rect x="108" y="48" width="4" height="8" rx="0.5" stroke="currentColor" stroke-width="0.6" fill="none" />
        <rect x="116" y="48" width="4" height="8" rx="0.5" stroke="currentColor" stroke-width="0.6" fill="none" />
        <rect x="124" y="48" width="4" height="8" rx="0.5" stroke="currentColor" stroke-width="0.6" fill="none" />
        <rect x="132" y="48" width="4" height="8" rx="0.5" stroke="currentColor" stroke-width="0.6" fill="none" />
        <rect x="140" y="48" width="4" height="8" rx="0.5" stroke="currentColor" stroke-width="0.6" fill="none" />
        <rect x="148" y="48" width="4" height="8" rx="0.5" stroke="currentColor" stroke-width="0.6" fill="none" />
        <rect x="156" y="48" width="4" height="8" rx="0.5" stroke="currentColor" stroke-width="0.6" fill="none" />
        <rect x="164" y="48" width="4" height="8" rx="0.5" stroke="currentColor" stroke-width="0.6" fill="none" />
        <rect x="172" y="48" width="4" height="8" rx="0.5" stroke="currentColor" stroke-width="0.6" fill="none" />
        <rect x="180" y="48" width="4" height="8" rx="0.5" stroke="currentColor" stroke-width="0.6" fill="none" />
        <!-- DRAM chips -->
        <rect x="20" y="14" width="18" height="10" rx="2" stroke="currentColor" stroke-width="0.8" fill="none" />
        <rect x="44" y="14" width="18" height="10" rx="2" stroke="currentColor" stroke-width="0.8" fill="none" />
        <rect x="68" y="14" width="18" height="10" rx="2" stroke="currentColor" stroke-width="0.8" fill="none" />
        <rect x="92" y="14" width="18" height="10" rx="2" stroke="currentColor" stroke-width="0.8" fill="none" />
        <rect x="116" y="14" width="18" height="10" rx="2" stroke="currentColor" stroke-width="0.8" fill="none" />
        <rect x="140" y="14" width="18" height="10" rx="2" stroke="currentColor" stroke-width="0.8" fill="none" />
        <rect x="164" y="14" width="18" height="10" rx="2" stroke="currentColor" stroke-width="0.8" fill="none" />
        <!-- Label area -->
        <rect x="20" y="28" width="50" height="6" rx="1" stroke="currentColor" stroke-width="0.5" fill="none" stroke-dasharray="2 1" />
        <!-- Register/buffer chip indicator (if applicable) -->
        {(entry.moduleRole === 'registered' || entry.moduleRole === 'load-reduced' || entry.moduleRole === 'multiplexed-rank') && (
          <>
            <rect x="100" y="30" width="14" height="8" rx="1.5" stroke="currentColor" stroke-width="1" fill="rgba(139,92,246,0.08)" />
            <text x="107" y="36.5" text-anchor="middle" font-size="5" fill="currentColor" font-family="monospace">REG</text>
          </>
        )}
        {entry.moduleRole === 'clocked-unbuffered' && (
          <>
            <rect x="100" y="30" width="14" height="8" rx="1.5" stroke="currentColor" stroke-width="1" fill="rgba(245,158,11,0.08)" />
            <text x="107" y="36.5" text-anchor="middle" font-size="5" fill="currentColor" font-family="monospace">CK</text>
          </>
        )}
      </svg>
    )}
    {isSoDimm && (
      <svg viewBox="0 0 140 50" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- SO-DIMM outline (shorter) -->
        <rect x="2" y="6" width="136" height="32" rx="3" stroke="currentColor" stroke-width="1.2" />
        <!-- Notch -->
        <rect x="52" y="4" width="10" height="5" rx="1" fill="var(--ink-900)" stroke="currentColor" stroke-width="0.8" />
        <!-- Edge connector fingers -->
        <rect x="10" y="38" width="3" height="7" rx="0.5" stroke="currentColor" stroke-width="0.6" fill="none" />
        <rect x="17" y="38" width="3" height="7" rx="0.5" stroke="currentColor" stroke-width="0.6" fill="none" />
        <rect x="24" y="38" width="3" height="7" rx="0.5" stroke="currentColor" stroke-width="0.6" fill="none" />
        <rect x="31" y="38" width="3" height="7" rx="0.5" stroke="currentColor" stroke-width="0.6" fill="none" />
        <rect x="38" y="38" width="3" height="7" rx="0.5" stroke="currentColor" stroke-width="0.6" fill="none" />
        <rect x="45" y="38" width="3" height="7" rx="0.5" stroke="currentColor" stroke-width="0.6" fill="none" />
        <rect x="66" y="38" width="3" height="7" rx="0.5" stroke="currentColor" stroke-width="0.6" fill="none" />
        <rect x="73" y="38" width="3" height="7" rx="0.5" stroke="currentColor" stroke-width="0.6" fill="none" />
        <rect x="80" y="38" width="3" height="7" rx="0.5" stroke="currentColor" stroke-width="0.6" fill="none" />
        <rect x="87" y="38" width="3" height="7" rx="0.5" stroke="currentColor" stroke-width="0.6" fill="none" />
        <rect x="94" y="38" width="3" height="7" rx="0.5" stroke="currentColor" stroke-width="0.6" fill="none" />
        <rect x="101" y="38" width="3" height="7" rx="0.5" stroke="currentColor" stroke-width="0.6" fill="none" />
        <rect x="108" y="38" width="3" height="7" rx="0.5" stroke="currentColor" stroke-width="0.6" fill="none" />
        <rect x="115" y="38" width="3" height="7" rx="0.5" stroke="currentColor" stroke-width="0.6" fill="none" />
        <!-- DRAM chips (fewer, smaller) -->
        <rect x="14" y="11" width="14" height="8" rx="2" stroke="currentColor" stroke-width="0.8" fill="none" />
        <rect x="34" y="11" width="14" height="8" rx="2" stroke="currentColor" stroke-width="0.8" fill="none" />
        <rect x="54" y="11" width="14" height="8" rx="2" stroke="currentColor" stroke-width="0.8" fill="none" />
        <rect x="74" y="11" width="14" height="8" rx="2" stroke="currentColor" stroke-width="0.8" fill="none" />
        <rect x="94" y="11" width="14" height="8" rx="2" stroke="currentColor" stroke-width="0.8" fill="none" />
        {entry.moduleRole === 'clocked-unbuffered' && (
          <>
            <rect x="80" y="23" width="12" height="7" rx="1.5" stroke="currentColor" stroke-width="1" fill="rgba(245,158,11,0.08)" />
            <text x="86" y="28.5" text-anchor="middle" font-size="4.5" fill="currentColor" font-family="monospace">CK</text>
          </>
        )}
      </svg>
    )}
    {isCamm && (
      <svg viewBox="0 0 160 80" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- CAMM2 board outline (rectangular, no edge fingers) -->
        <rect x="2" y="2" width="156" height="76" rx="4" stroke="currentColor" stroke-width="1.2" />
        <!-- Connector area (pressure-mount) -->
        <rect x="10" y="60" width="140" height="12" rx="2" stroke="currentColor" stroke-width="0.8" stroke-dasharray="3 2" />
        <text x="80" y="69" text-anchor="middle" font-size="6" fill="currentColor" font-family="monospace">compression connector</text>
        <!-- DRAM chips (LPDDR BGA packages — square) -->
        <rect x="14" y="10" width="12" height="12" rx="2" stroke="currentColor" stroke-width="0.8" fill="none" />
        <rect x="32" y="10" width="12" height="12" rx="2" stroke="currentColor" stroke-width="0.8" fill="none" />
        <rect x="50" y="10" width="12" height="12" rx="2" stroke="currentColor" stroke-width="0.8" fill="none" />
        <rect x="68" y="10" width="12" height="12" rx="2" stroke="currentColor" stroke-width="0.8" fill="none" />
        <rect x="86" y="10" width="12" height="12" rx="2" stroke="currentColor" stroke-width="0.8" fill="none" />
        <rect x="104" y="10" width="12" height="12" rx="2" stroke="currentColor" stroke-width="0.8" fill="none" />
        <rect x="122" y="10" width="12" height="12" rx="2" stroke="currentColor" stroke-width="0.8" fill="none" />
        <!-- Second row -->
        <rect x="14" y="28" width="12" height="12" rx="2" stroke="currentColor" stroke-width="0.8" fill="none" />
        <rect x="32" y="28" width="12" height="12" rx="2" stroke="currentColor" stroke-width="0.8" fill="none" />
        <rect x="50" y="28" width="12" height="12" rx="2" stroke="currentColor" stroke-width="0.8" fill="none" />
        <rect x="68" y="28" width="12" height="12" rx="2" stroke="currentColor" stroke-width="0.8" fill="none" />
        <rect x="86" y="28" width="12" height="12" rx="2" stroke="currentColor" stroke-width="0.8" fill="none" />
        <rect x="104" y="28" width="12" height="12" rx="2" stroke="currentColor" stroke-width="0.8" fill="none" />
        <rect x="122" y="28" width="12" height="12" rx="2" stroke="currentColor" stroke-width="0.8" fill="none" />
        <!-- PMIC area -->
        <rect x="14" y="46" width="20" height="10" rx="2" stroke="currentColor" stroke-width="0.6" stroke-dasharray="2 1" fill="none" />
        <text x="24" y="53" text-anchor="middle" font-size="5" fill="currentColor" font-family="monospace">PMIC</text>
      </svg>
    )}
    {!isFullDimm && !isSoDimm && !isCamm && (
      <svg viewBox="0 0 160 60" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect x="2" y="8" width="156" height="40" rx="3" stroke="currentColor" stroke-width="1.2" />
        <rect x="14" y="14" width="18" height="10" rx="2" stroke="currentColor" stroke-width="0.8" fill="none" />
        <rect x="38" y="14" width="18" height="10" rx="2" stroke="currentColor" stroke-width="0.8" fill="none" />
        <rect x="62" y="14" width="18" height="10" rx="2" stroke="currentColor" stroke-width="0.8" fill="none" />
        <rect x="86" y="14" width="18" height="10" rx="2" stroke="currentColor" stroke-width="0.8" fill="none" />
        <rect x="110" y="14" width="18" height="10" rx="2" stroke="currentColor" stroke-width="0.8" fill="none" />
      </svg>
    )}
  </div>

  <div class="module-card__content">
    <div class="module-card__header">
      <span
        class="module-card__badge acronym"
        style={`background: ${colors.bg}; color: ${colors.text}; border: 1px solid ${colors.border};`}
      >
        {entry.acronym}
      </span>
      {entry.jedecRef && (
        <span class="module-card__jedec">{entry.jedecRef}</span>
      )}
    </div>

    <p class="module-card__full-name">{entry.fullName}</p>

    <p class="module-card__role">{entry.role}</p>

    <p class="module-card__description">{entry.description}</p>

    <div class="module-card__meta">
      <div class="module-card__meta-row">
        <span class="module-card__meta-label">Form Factor</span>
        <span class="module-card__meta-value">{entry.formFactor}</span>
      </div>
      <div class="module-card__meta-row">
        <span class="module-card__meta-label">Electrical Role</span>
        <span
          class="module-card__role-chip"
          style={`background: ${colors.bg}; color: ${colors.text}; border-color: ${colors.border};`}
        >
          {entry.moduleRole.replace(/-/g, ' ')}
        </span>
      </div>
    </div>

    <div class="module-card__compat" role="list" aria-label="Compatible DRAM standards">
      <span class="module-card__meta-label">Compatible with</span>
      <div class="module-card__compat-chips">
        {entry.compatibleStandards.map((std) => (
          <span class="chip" role="listitem">{std.toUpperCase()}</span>
        ))}
      </div>
    </div>
  </div>
</article>

<style>
  .module-card {
    position: relative;
    padding-left: var(--space-8);
    overflow: hidden;
    isolation: isolate;
  }

  .module-card__stripe {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: 4px;
    background: var(--role-stripe, var(--ink-300));
    border-radius: var(--radius-lg) 0 0 var(--radius-lg);
  }

  .module-card__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .module-card__header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .module-card__badge {
    display: inline-flex;
    align-items: center;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-md);
    font-size: var(--text-lg);
    letter-spacing: 0.06em;
    line-height: 1;
  }

  .module-card__jedec {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-300);
    letter-spacing: 0.03em;
  }

  .module-card__full-name {
    font-size: var(--text-sm);
    color: var(--ink-300);
    font-style: italic;
    max-inline-size: none;
  }

  .module-card__role {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--ink-50);
    max-inline-size: none;
    line-height: 1.4;
  }

  .module-card__description {
    font-size: var(--text-sm);
    color: var(--ink-200);
    line-height: 1.6;
    max-inline-size: 60ch;
  }

  .module-card__meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-3);
    background: rgba(255, 255, 255, 0.02);
    border-radius: var(--radius-md);
    border: 1px solid var(--surface-stroke);
  }

  .module-card__meta-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .module-card__meta-label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-300);
  }

  .module-card__meta-value {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--ink-100);
  }

  .module-card__role-chip {
    display: inline-flex;
    align-items: center;
    padding: 2px var(--space-2);
    border-radius: 9999px;
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: capitalize;
    border: 1px solid;
  }

  .module-card__compat {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .module-card__compat-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
</style>
