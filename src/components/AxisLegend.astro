---
/**
 * AxisLegend — explains the four qualitative comparison axes used throughout the site.
 * Pure diagram, no numeric scores.
 */
---

<div class="axis-legend" role="region" aria-label="Comparison axes legend">
  <div class="axis-legend__item">
    <div class="axis-legend__icon" aria-hidden="true">
      <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect x="4" y="4" width="16" height="16" rx="3" stroke="var(--cyan-500)" stroke-width="1.5" fill="none" />
        <rect x="28" y="4" width="16" height="16" rx="3" stroke="var(--amber-500)" stroke-width="1.5" fill="none" />
        <rect x="4" y="28" width="16" height="16" rx="3" stroke="var(--teal-500)" stroke-width="1.5" fill="none" />
        <rect x="28" y="28" width="16" height="16" rx="3" stroke="var(--violet-500)" stroke-width="1.5" fill="none" />
        <circle cx="24" cy="24" r="3" fill="var(--ink-100)" />
      </svg>
    </div>
    <span class="axis-legend__label">Use Case</span>
    <span class="axis-legend__desc">Where the memory is used: PC main memory, GPU subsystem, mobile/embedded, or accelerator package.</span>
  </div>

  <div class="axis-legend__item">
    <div class="axis-legend__icon" aria-hidden="true">
      <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect x="4" y="14" width="10" height="20" rx="2" stroke="var(--cyan-500)" stroke-width="1.5" fill="none" />
        <rect x="19" y="14" width="10" height="20" rx="2" stroke="var(--teal-500)" stroke-width="1.5" fill="none" />
        <rect x="34" y="14" width="10" height="20" rx="2" stroke="var(--amber-500)" stroke-width="1.5" fill="none" />
        <line x1="14" y1="24" x2="19" y2="24" stroke="var(--ink-300)" stroke-width="1" />
        <line x1="29" y1="24" x2="34" y2="24" stroke="var(--ink-300)" stroke-width="1" />
      </svg>
    </div>
    <span class="axis-legend__label">DRAM Family</span>
    <span class="axis-legend__desc">The standard generation: <strong>DDR</strong>, <strong>LPDDR</strong> (low-power), <strong>GDDR</strong> (graphics), or <strong>HBM</strong> (stacked high-bandwidth).</span>
  </div>

  <div class="axis-legend__item">
    <div class="axis-legend__icon" aria-hidden="true">
      <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- DIMM outline -->
        <rect x="2" y="10" width="28" height="6" rx="1" stroke="var(--ink-100)" stroke-width="1" fill="none" />
        <rect x="4" y="11.5" width="2" height="3" rx="0.5" fill="var(--ink-300)" />
        <rect x="8" y="11.5" width="2" height="3" rx="0.5" fill="var(--ink-300)" />
        <rect x="12" y="11.5" width="2" height="3" rx="0.5" fill="var(--ink-300)" />
        <!-- SO-DIMM outline -->
        <rect x="2" y="22" width="18" height="5" rx="1" stroke="var(--ink-100)" stroke-width="1" fill="none" />
        <rect x="4" y="23.25" width="2" height="2.5" rx="0.5" fill="var(--ink-300)" />
        <!-- Stack -->
        <rect x="2" y="34" width="12" height="3" rx="0.5" stroke="var(--violet-500)" stroke-width="1" fill="none" />
        <rect x="2" y="38" width="12" height="3" rx="0.5" stroke="var(--violet-500)" stroke-width="1" fill="none" />
        <rect x="2" y="42" width="12" height="3" rx="0.5" stroke="var(--violet-500)" stroke-width="1" fill="none" />
        <!-- BGA dots -->
        <circle cx="36" cy="14" r="2" fill="var(--ink-300)" />
        <circle cx="42" cy="14" r="2" fill="var(--ink-300)" />
        <circle cx="36" cy="20" r="2" fill="var(--ink-300)" />
        <circle cx="42" cy="20" r="2" fill="var(--ink-300)" />
        <circle cx="36" cy="26" r="2" fill="var(--ink-300)" />
        <circle cx="42" cy="26" r="2" fill="var(--ink-300)" />
      </svg>
    </div>
    <span class="axis-legend__label">Packaging</span>
    <span class="axis-legend__desc">Physical form: DIMM module, SO-DIMM, CAMM, soldered (BGA/PoP), or interposer stack (HBM).</span>
  </div>

  <div class="axis-legend__item">
    <div class="axis-legend__icon" aria-hidden="true">
      <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Module with buffer chip -->
        <rect x="2" y="12" width="44" height="24" rx="3" stroke="var(--ink-100)" stroke-width="1.5" fill="none" />
        <!-- DRAM chips -->
        <rect x="6" y="16" width="8" height="6" rx="1" stroke="var(--ink-300)" stroke-width="1" fill="none" />
        <rect x="17" y="16" width="8" height="6" rx="1" stroke="var(--ink-300)" stroke-width="1" fill="none" />
        <!-- Buffer/register chip (highlighted) -->
        <rect x="30" y="16" width="12" height="6" rx="1" stroke="var(--cyan-500)" stroke-width="1.5" fill="rgba(6,182,212,0.1)" />
        <!-- Arrow from controller through buffer -->
        <line x1="10" y1="30" x2="30" y2="30" stroke="var(--ink-300)" stroke-width="1" stroke-dasharray="2 2" />
        <polygon points="30,28 34,30 30,32" fill="var(--ink-300)" />
        <circle cx="6" cy="30" r="2" fill="var(--ink-100)" />
      </svg>
    </div>
    <span class="axis-legend__label">Module Electrical Role</span>
    <span class="axis-legend__desc">How the module buffers signals: <strong>unbuffered</strong>, <strong>registered</strong>, <strong>clocked-unbuffered</strong> (CUDIMM), or <strong>multiplexed-rank</strong> (MRDIMM).</span>
  </div>
</div>
