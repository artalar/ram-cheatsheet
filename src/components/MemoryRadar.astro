---
import type { RamKind } from "../data/ramDesignSystem";
import { axisNumericScores, designAxes } from "../data/ramDesignSystem";

interface Props {
	kind: RamKind;
	size?: number;
}

const { kind, size = 200 } = Astro.props;
const scores = axisNumericScores(kind.axes);
const axisOrder = designAxes.map((axis) => axis.id);
const maxScore = 4;
const center = size / 2;
const maxRadius = size * 0.36;
const points = axisOrder.map((axisId, index) => {
	const angle = (Math.PI * 2 * index) / axisOrder.length - Math.PI / 2;
	const value = scores[axisId];
	const radius = (value / maxScore) * maxRadius;
	const x = center + radius * Math.cos(angle);
	const y = center + radius * Math.sin(angle);
	return `${x.toFixed(2)},${y.toFixed(2)}`;
});
const polygonPoints = points.join(" ");
const ringRadii = [0.25, 0.5, 0.75, 1].map((fraction) => maxRadius * fraction);
---

<div class="radar" style={`--chip:${kind.color};--glow:${kind.glow}`}>
	<svg
		width={size}
		height={size}
		viewBox={`0 0 ${size} ${size}`}
		role="img"
		aria-label={`Radar chart for ${kind.acronym}`}
	>
		<title>{kind.acronym} trait shape</title>
		{
			ringRadii.map((radius) => (
				<circle
					cx={center}
					cy={center}
					r={radius}
					fill="none"
					stroke="rgba(148,163,184,0.18)"
					stroke-width="1"
				/>
			))
		}
		{
			axisOrder.map((_, index) => {
				const angle = (Math.PI * 2 * index) / axisOrder.length - Math.PI / 2;
				const x = center + maxRadius * Math.cos(angle);
				const y = center + maxRadius * Math.sin(angle);
				return <line x1={center} y1={center} x2={x} y2={y} stroke="rgba(148,163,184,0.22)" stroke-width="1" />;
			})
		}
		<polygon
			points={polygonPoints}
			fill={kind.color}
			fill-opacity="0.28"
			stroke={kind.color}
			stroke-width="2"
			stroke-linejoin="round"
		/>
	</svg>
	<ul class="axis-mini">
		{
			designAxes.map((axis) => (
				<li>
					<span class="axis-mini-label">{axis.shortLabel}</span>
					<span class="axis-mini-value">{scores[axis.id].toFixed(1)}</span>
				</li>
			))
		}
	</ul>
</div>

<style>
	.radar {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0.75rem;
		align-items: center;
	}

	svg {
		filter: drop-shadow(0 0 18px var(--glow));
	}

	.axis-mini {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.2rem;
		font-size: 0.72rem;
		color: #94a3b8;
	}

	.axis-mini li {
		display: flex;
		justify-content: space-between;
		gap: 0.5rem;
		border-bottom: 1px dashed rgba(148, 163, 184, 0.18);
		padding-bottom: 0.15rem;
	}

	.axis-mini-value {
		font-variant-numeric: tabular-nums;
		color: #e2e8f0;
	}
</style>
